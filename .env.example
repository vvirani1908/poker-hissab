# Email sign-up codes (Brevo, free plan: 300 emails/day). Set these in Netlify -> Site configuration -> Environment variables.
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=the-sender-email-you-verified-in-brevo@example.com
MAIL_FROM_NAME=Poker Hissab
# Optional: emergency host recovery code (resets any password via "Host recovery code" on the sign-in pop-up)
RECOVERY_CODE=pick-a-long-secret-phrase
# Optional: cap on emails per day (default 150)
MAIL_DAILY_CAP=150
# LOCAL TESTING ONLY, never set on the real site: shows the 6-digit code on screen instead of emailing it
# DEV_SHOW_OTP=1
