# ---- Email for sign-up codes: pick ONE of the two options and set it in Netlify -> Site configuration -> Environment variables ----

# OPTION 1 (easiest, free): send from a Gmail account using a Gmail "app password"
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=the-16-character-app-password-from-google
# MAIL_FROM_NAME=Poker Hissab

# OPTION 2: Brevo (free plan, but new accounts can be held for review)
# BREVO_API_KEY=your-brevo-api-key
# MAIL_FROM=the-sender-email-you-verified-in-brevo@example.com

# Optional: emergency host recovery code ("Host recovery code" link on the sign-in pop-up)
# RECOVERY_CODE=pick-a-long-secret-phrase
# Optional: cap on emails per day (default 150)
# MAIL_DAILY_CAP=150

# LOCAL TESTING ONLY, never set on the real site: shows the 6-digit code on screen instead of emailing it
# DEV_SHOW_OTP=1
